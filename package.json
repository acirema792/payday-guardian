{
  "name": "payday-guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-employer payroll agent on Airwallex (Agentic Banking Hackathon, Kit 6)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node --env-file=.env scripts/check-sandbox.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node --env-file=.env scripts/smoke-live.ts",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "provision": "node --env-file=.env scripts/provision-employers.ts",
    "smoke:connected": "node --env-file=.env scripts/smoke-connected.ts",
    "reader:eval": "node --env-file=.env scripts/reader-eval.ts",
    "console": "node scripts/console.ts",
    "demo:live": "node --env-file=.env scripts/demo.ts --live",
    "webhooks": "node --env-file=.env scripts/webhook-server.ts",
    "evidence": "node --env-file-if-exists=.env scripts/export-evidence.ts",
    "site": "node scripts/build-site.ts",
    "metal:setup": "node --env-file=.env scripts/metal-setup.ts",
    "benchmark": "node scripts/benchmark.ts",
    "mutation": "node scripts/mutation.ts",
    "metal:refusals": "node --env-file=.env scripts/metal-refusals.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@metalntwx/metal-agent": "0.3.3",
    "zod": "4.6.6"
  },
  "license": "MIT"
}
