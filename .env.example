# Copy to .env and fill in. Never commit .env.
# Sandbox web app > Developer > API keys > New scoped key
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com

# Sandbox web app > Developer > Webhooks (copy the secret when you create the subscription)
AWX_WEBHOOK_SECRET=

# console.anthropic.com (the hackathon gives free Claude credits)
ANTHROPIC_API_KEY=
